# ============================================================
# Environment Variables untuk Deployment di aaPanel / Server
# ============================================================

# Mode environment (production saat di server aaPanel)
NODE_ENV=production

# Port aplikasi (sesuaikan dengan port yang diset di aaPanel, default: 3000 atau 3002)
PORT=3000

# Konfigurasi Supabase (Wajib diisi sesuai project Supabase Anda)
NEXT_PUBLIC_SUPABASE_URL=https://your_project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

